#!/bin/sh
# emux-resize-wall — resize the active pane and its vertically-stacked column
# companions together, so a whole column moves as one. Panes do NOT have to be
# perfectly aligned: this works for jagged/offset grids, not just a clean 2x2.
#
# A companion is a pane in a DIFFERENT row (vertical ranges don't overlap) whose
# horizontal span lines up with the active pane's — i.e. one's horizontal
# midpoint falls within the other's width. Resizing the active pane and all its
# companions the same way moves their shared vertical wall together; the panes
# on the far side of the wall follow automatically.
#
# Usage (bound by emux.tmux):
#   emux-resize-wall L [n]   # move the wall left  n cells (default 5)
#   emux-resize-wall R [n]   # move the wall right n cells
#
# Test hooks (used by the repo's checks; harmless in normal use):
#   EMUX_PANES  override the pane list
#               (lines: "<id> <left> <top> <width> <height> <active>")
#   EMUX_PRINT=1  print the target pane ids instead of resizing them

dir="$1"
amount="${2:-5}"
case "$dir" in
	L | R) ;;
	*) echo "usage: emux-resize-wall <L|R> [n]" >&2; exit 2 ;;
esac

if [ -n "${EMUX_PANES:-}" ]; then
	panes="$EMUX_PANES"
else
	panes=$(tmux list-panes -F '#{pane_id} #{pane_left} #{pane_top} #{pane_width} #{pane_height} #{pane_active}')
fi

targets=$(printf '%s\n' "$panes" | awk '
	{
		id[NR] = $1; left[NR] = $2; top[NR] = $3
		right[NR] = $2 + $4 - 1; bottom[NR] = $3 + $5 - 1; midx[NR] = $2 + $4 / 2
		n = NR
		if ($6 == 1) a = NR
	}
	END {
		if (n <= 1) exit
		if (a == 0) a = 1
		for (i = 1; i <= n; i++) {
			take = 0
			if (i == a)
				take = 1
			else if (top[i] > bottom[a] || bottom[i] < top[a])   # different row
				if ((midx[i] >= left[a] && midx[i] <= right[a]) ||
				    (midx[a] >= left[i] && midx[a] <= right[i]))  # columns line up
					take = 1
			if (take) print id[i]
		}
	}')

[ -z "$targets" ] && exit 0

if [ "${EMUX_PRINT:-}" = 1 ]; then
	printf '%s\n' "$targets"
else
	printf '%s\n' "$targets" | while IFS= read -r t; do
		[ -n "$t" ] && tmux resize-pane -t "$t" -"$dir" "$amount"
	done
fi
